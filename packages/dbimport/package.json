{
  "name": "@ddtx/dbimport",
  "version": "0.1.0",
  "private": true,
  "description": "Splits ecu.zip into the static tree — the same core for the CLI and the browser",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@ddtx/core": "workspace:*",
    "fflate": "^0.8.2"
  }
}
