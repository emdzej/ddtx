{
  "name": "ddtx",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based Renault/Dacia/Nissan ECU diagnostics — a TypeScript port of DDT4All",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "ci": "turbo run build typecheck && vitest run",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "prettier": "^3.5.1",
    "turbo": "^2.8.10",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
